---
import PageLayout from '@layouts/PageLayout.astro'
import { Heading } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

const accessibilityFeatures = [
  ['Skip link', 'to bypass navigation and jump to main content'],
  ['Logical heading hierarchy', 'for screen reader navigation'],
  ['Landmark regions', '(header, nav, main, footer) for assistive technology navigation'],
  ['Full keyboard navigation', 'for all interactive elements'],
  ['Escape key', 'closes modals and menus with proper focus management'],
  ['Color contrast', 'meeting WCAG AA requirements'],
  ['Responsive design', 'adapting to different viewport sizes'],
  ['Visible focus indicators', 'for keyboard navigation'],
  ['Reduced motion support', 'respecting user preferences'],
  ['ARIA attributes', 'throughout components'],
  ['Screen reader labels', 'for interactive elements'],
  ['Language attributes', 'for proper pronunciation'],
  ['Semantic HTML', 'for meaningful structure'],
  ['Form validation', 'with clear error identification and suggestions'],
  ['Text alternatives', 'for non-text content'],
]

const assessmentApproaches = [
  'Self-evaluation',
  'Community accessibility audits',
  'Automated testing with tools like axe, WAVE, and Lighthouse',
  'Manual testing with screen readers (VoiceOver, NVDA, JAWS)',
  'Keyboard-only navigation testing',
]
---

<PageLayout
  title="Accessibility statement"
  description="Our commitment to making the Flint Hills Tenants United website accessible for everyone."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Accessibility statement' }]}
>
  <!-- Intro -->
  <section class="page-hero" data-reveal>
    <div class="narrow space-content container">
      <p class="eyebrow">
        <Icon name="lucide:accessibility" aria-hidden="true" />
        Accessibility
      </p>
      <Heading level="h1" class="page-title text-balance">Accessibility statement</Heading>
      <p class="lead">Our commitment to making this website accessible for everyone.</p>
      <p>
        We believe the internet should be accessible to everyone, regardless of ability or circumstance. Housing
        organizing only works if every tenant can reach the information they need, so we work continually to improve
        this site for everyone by applying the relevant accessibility standards.
      </p>
    </div>
  </section>

  <!-- Compliance + feedback -->
  <section class="section" data-reveal>
    <div class="narrow space-content container">
      <Heading level="h2">WCAG compliance</Heading>
      <p>
        <strong>Flint Hills Tenants United</strong> is designed to conform to the Web Content Accessibility Guidelines (WCAG)
        2.2, Level AA. These guidelines explain how to make web content more accessible to people with a wide array of disabilities,
        including visual, auditory, physical, speech, cognitive, language, learning, and neurological disabilities.
      </p>

      <Heading level="h2" id="feedback">Feedback</Heading>
      <p>
        We welcome your feedback on the accessibility of <strong>Flint Hills Tenants United</strong>. If you encounter
        an accessibility barrier, tell us using the <a href="#contact">contact form</a> at the bottom of any page. We will
        work with you to get you the information you need in a format that works for you.
      </p>
    </div>
  </section>

  <!-- Technical specifications -->
  <section class="section" data-reveal>
    <div class="narrow space-content container">
      <Heading level="h2">Technical specifications</Heading>
      <p>Accessibility of <strong>Flint Hills Tenants United</strong> relies on the following technologies:</p>
      <ul>
        <li>HTML</li>
        <li>WAI-ARIA</li>
        <li>CSS</li>
        <li>JavaScript</li>
      </ul>
      <p>
        These technologies are used in combination with modern browsers and assistive technologies to provide an
        accessible experience.
      </p>

      <Heading level="h3">Accessibility features</Heading>
      <ul>
        {
          accessibilityFeatures.map(([name, detail]) => (
            <li>
              <strong>{name}</strong> {detail}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Limitations + assessment -->
  <section class="section section--flow" data-reveal>
    <div class="narrow space-content container">
      <Heading level="h2">Limitations and alternatives</Heading>
      <p>
        Despite our best efforts, there may be some limitations. Documents and resources published by outside
        organizations — courts, legal aid providers, and government agencies — are outside our control and may not meet
        the same standards. Where that happens, contact us and we will help you get the same information another way.
      </p>
      <p>
        Please <a href="#feedback">let us know</a> if you encounter an issue not listed here.
      </p>

      <Heading level="h2">Assessment approach</Heading>
      <p>We assess accessibility through the following approaches:</p>
      <ul>
        {assessmentApproaches.map((approach) => <li>{approach}</li>)}
      </ul>

      <p class="statement-meta">
        This statement was created on August 14, 2026 and last updated on August 14, 2026 using the <a
          href="https://www.w3.org/WAI/planning/statements/generator/">W3C Accessibility Statement Generator Tool</a
        >.
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .statement-meta {
    border-top: 1px solid var(--border-color-subtle);
    padding-block-start: var(--space-m);
    font-size: var(--font-size--1);
  }
</style>
